  "condition": "ev2_collect=exclude",
  "nextId": ""
 },
 {
  "id": "ev3_sujin_01",
  "sceneId": "ev3",
  "speakerId": "sujin",
  "text": "같은 자료를 두 사람이 만들고 있었네요. 지금 있는 것부터 같이 볼까요?",
