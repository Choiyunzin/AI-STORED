  "condition": "always",
  "nextId": ""
 },
 {
  "id": "ev3_p_clean",
  "sceneId": "ev3",
  "speakerId": "sujin",
  "text": "함께 쓰려면 찾을 수 있어야 하고, 어디까지 공유해도 되는지도 알아야 해요.",
