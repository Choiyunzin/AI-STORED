[
 {
  "id": "intro_hong_01",
  "sceneId": "intro",
  "speakerId": "hong",
  "text": "다음 주에 신입사원 30명이 들어옵니다. 안내자료와 설문, 운영 준비까지 마무리해봅시다.",
  "expression": "focused",
  "condition": "always",
  "nextId": "intro_sujin_01"
 },
 {
  "id": "intro_sujin_01",
  "sceneId": "intro",
  "speakerId": "sujin",
  "text": "승인된 사내 AI와 도구를 쓰고, 서로 만든 자료를 확인하면서 진행해요.",
  "expression": "calm",
  "condition": "always",
  "nextId": "intro_yunjin_01"
 },
 {
  "id": "intro_yunjin_01",
  "sceneId": "intro",
  "speakerId": "yunjin",
  "text": "네, AI로 줄일 수 있는 일부터 나눠볼게요. 내부 기준은 같이 봐주시면 좋겠어요.",
  "expression": "bright",
  "condition": "always",
  "nextId": ""
 },
 {
  "id": "ev1_chian_01",
  "sceneId": "ev1",
  "speakerId": "chian",
  "text": "안내문 세 줄 고치려다가 AI랑 대화만 길어졌네요. 이거 제가 치는 게 빠르겠는디요?",
  "expression": "smirk",
  "condition": "always",
  "nextId": "ev1_heeyeon_01"
 },
 {
  "id": "ev1_heeyeon_01",
  "sceneId": "ev1",
  "speakerId": "heeyeon",
  "text": "반면에 자유응답 300건은 아직 수작업이네요. 둘을 같은 방식으로 처리할 필요는 없어요.",
  "expression": "focused",
  "condition": "always",
  "nextId": "ev1_yunjin_01"
 },
 {
  "id": "ev1_yunjin_01",
  "sceneId": "ev1",
  "speakerId": "yunjin",
  "text": "업무마다 방식을 따로 정해볼게요. AI한테 넘길 자료도 같이 골라야겠네예.",
  "expression": "thinking",
  "condition": "always",
  "nextId": ""
 },
 {
  "id": "ev1_res_a_human",
  "sceneId": "ev1",
  "speakerId": "chian",
  "text": "세 줄은 손으로 금방이제. 바뀐 데만 딱 바뀌었어요.",
  "expression": "happy",
  "condition": "ev1_A=human",
  "nextId": ""
 },
 {
  "id": "ev1_res_a_draft",
  "sceneId": "ev1",
  "speakerId": "heeyeon",
  "text": "초안은 금방 왔는데, 확인까지 하니 손으로 고친 거랑 비슷하네요. 다음엔 직접 해도 되겠어요.",
  "expression": "neutral",
  "condition": "ev1_A=draft",
  "nextId": ""
 },
 {
  "id": "ev1_res_a_full",
  "sceneId": "ev1",
  "speakerId": "chian",
  "text": "바꿀 건 세 줄이었는디, 멀쩡한 문장까지 다 바뀌었네요.",
  "expression": "worried",
  "condition": "ev1_A=full",
  "nextId": "ev1_res_a_full_2"
 },
 {
  "id": "ev1_res_a_full_2",
  "sceneId": "ev1",
  "speakerId": "hong",
  "text": "이미 검토 끝난 문장이 바뀌었으니, 전체를 다시 확인해야겠어요.",
  "expression": "serious",
  "condition": "ev1_A=full",
  "nextId": ""
 },
 {
  "id": "ev1_res_b_human",
  "sceneId": "ev1",
  "speakerId": "sujin",
  "text": "꼼꼼하게 보고 있네요. 다만 뒤에 남은 업무 시간도 같이 봐야겠어요.",
  "expression": "calm",
  "condition": "ev1_B=human",
  "nextId": ""
 },
 {
  "id": "ev1_res_b_draft",
  "sceneId": "ev1",
  "speakerId": "jongyun",
  "text": "분류는 빨라졌네요. 이 의견이 그때 어떤 상황에서 나왔는지는 제가 설명할게요.",
  "expression": "smile",
  "condition": "ev1_B=draft",
  "nextId": "ev1_res_b_draft_2"
 },
 {
  "id": "ev1_res_b_draft_2",
  "sceneId": "ev1",
  "speakerId": "yunjin",
  "text": "원문 표본도 같이 봤어요. 묶음마다 대표 문장 붙여 둘게요.",
  "expression": "bright",
  "condition": "ev1_B=draft",
  "nextId": ""
 },
 {
  "id": "ev1_res_b_full",
  "sceneId": "ev1",
  "speakerId": "heeyeon",
  "text": "분류표가 깔끔하긴 한데요. 주차 불편이 식사 불만에 묶였어요. 원문은 누가 봤죠?",
  "expression": "sharp",
  "condition": "ev1_B=full",
  "nextId": "ev1_res_b_full_2"
 },
 {
  "id": "ev1_res_b_full_2",
  "sceneId": "ev1",
  "speakerId": "yunjin",
  "text": "아, 확정 전에 표본을 안 봤네요. 분석표에 '원문 미확인'으로 표시해 둘게요.",
  "expression": "sheepish",
  "condition": "ev1_B=full",
  "nextId": ""
 },
 {
  "id": "ev1_res_scope_all",
  "sceneId": "ev1",
  "speakerId": "hong",
  "text": "전체 묶음을 넘기니 이용권도 더 들고, 관계없는 내용을 걸러내는 데 시간이 더 갔네요.",
  "expression": "neutral",
  "condition": "ev1_scope=all",
  "nextId": ""
 },
 {
  "id": "ev1_res_scope_rel",
  "sceneId": "ev1",
  "speakerId": "sujin",
  "text": "필요한 자료만 넘기니 결과도 빨리 나오고 확인하기도 쉽네요.",
  "expression": "smile",
  "condition": "ev1_scope=related",
  "nextId": ""
 },
 {
  "id": "ev1_res_heoin",
  "sceneId": "ev1",
  "speakerId": "heoin",
  "text": "근데 안내문을 안 읽는 게 문제면, 안내문 말고 다른 걸 만들어야 하는 거 아닌가요?",
  "expression": "excited",
  "condition": "always",
  "nextId": ""
 },
 {
  "id": "ev2_heoin_01",
  "sceneId": "ev2",
  "speakerId": "heoin",
  "text": "정보를 누르면 답이 나오는 안내 도구는 어때요? 신입사원이 직접 골라보게요.",
  "expression": "excited",
  "condition": "always",
  "nextId": "ev2_yunjin_01"
 },
 {
  "id": "ev2_yunjin_01",
  "sceneId": "ev2",
  "speakerId": "yunjin",
  "text": "화면 데모 버전은 AI로 만들어볼 수 있어요.",
  "expression": "bright",
  "condition": "always",
  "nextId": "ev2_heeyeon_01"
 },
 {
  "id": "ev2_heeyeon_01",
  "sceneId": "ev2",
  "speakerId": "heeyeon",
  "text": "목표, 필수 기능, 저장 방식부터 정하죠. 예쁘게 뜨는 것과 운영되는 건 달라요.",
  "expression": "focused",
  "condition": "always",
  "nextId": "ev2_jongyun_01"
 },
 {
  "id": "ev2_jongyun_01",
  "sceneId": "ev2",
  "speakerId": "jongyun",
  "text": "지난 자료 드릴게요. 출입 절차는 올해 기준으로 다시 확인해야 해요.",
  "expression": "calm",
  "condition": "always",
  "nextId": ""
 },
 {
  "id": "ev2_m_quick",
  "sceneId": "ev2",
  "speakerId": "heoin",
  "text": "벌써 화면이 떴네요! 근데 여기 '자동 취합 완료' 버튼은 진짜 되는 거예요?",
  "expression": "excited",
  "condition": "ev2_method=quick",
  "nextId": "ev2_m_quick_2"
 },
 {
  "id": "ev2_m_quick_2",
  "sceneId": "ev2",
  "speakerId": "heeyeon",
  "text": "화면에 써 있다고 되는 건 아니에요. 저장 경로는 아직 정한 적 없어요.",
  "expression": "sharp",
  "condition": "ev2_method=quick",
  "nextId": ""
 },
 {
  "id": "ev2_m_prd",
  "sceneId": "ev2",
  "speakerId": "heeyeon",
  "text": "대상, 필수 기능, 실행 조건, 완료 기준. 이 네 칸이면 빠진 게 바로 보여요.",
  "expression": "smile",
  "condition": "ev2_method=prd",
  "nextId": "ev2_m_prd_2"
 },
 {
  "id": "ev2_m_prd_2",
  "sceneId": "ev2",
  "speakerId": "hong",
  "text": "좋아요. 완료 기준이 있으니 승인할 때 판단하기도 쉽겠네요.",
  "expression": "focused",
  "condition": "ev2_method=prd",
  "nextId": ""
 },
 {
  "id": "ev2_m_reuse",
  "sceneId": "ev2",
  "speakerId": "jongyun",
  "text": "작년에 쓰던 안내 도구가 있어요. 당시엔 같은 질문이 너무 많이 와서 이걸로 바꿨죠.",
  "expression": "smile",
  "condition": "ev2_method=reuse",
  "nextId": "ev2_m_reuse_2"
 },
 {
  "id": "ev2_m_reuse_2",
  "sceneId": "ev2",
  "speakerId": "chian",
  "text": "근디 그거 의견 남기는 칸은 없었을 거요. 출입 안내도 작년 거고.",
  "expression": "smirk",
  "condition": "ev2_method=reuse",
  "nextId": ""
 },
 {
  "id": "ev2_flow_hint",
  "sceneId": "ev2",
  "speakerId": "sujin",
  "text": "기본 흐름은 짜 뒀어요. 연결 두세 개만 바꿔보면 돼요.",
