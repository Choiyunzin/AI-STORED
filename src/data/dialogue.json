  "condition": "always",
  "nextId": ""
 },
 {
  "id": "ev2_f_notice",
  "sceneId": "ev2",
  "speakerId": "jongyun",
  "text": "올해 공지를 같이 넣었으니, 바뀐 출입 절차가 분석에 잡혔네요.",
