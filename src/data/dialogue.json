  "condition": "ev3_storage=shared",
  "nextId": ""
 },
 {
  "id": "ev3_pii_found",
  "sceneId": "ev3",
  "speakerId": "yunjin",
  "text": "잠깐만예, 운영 명단 파일에 개인 연락처랑 교육과 상관없는 메모가 들어 있어요.",
